# CueBound configuration. Copy to .env (git-ignored) or export in your shell. Every value is optional.

# Where projects, clips, takes and exports are stored. Use a different folder per instance.
DATA_DIR=./data

# The server has no login, so keep it on loopback unless you add one in front of it.
PORT=3000
HOST=127.0.0.1

# Livepeer Agent. Empty = keyless demo credit from the creative MCP endpoint.
# A key is sent as "Authorization: Bearer <key>". Never commit a real key.
LIVEPEER_API_KEY=
# Override only for testing, e.g. an unreachable address to exercise the unknown-outcome path.
# LIVEPEER_MCP_URL=https://agent.livepeer.org/api/mcp/creative

# OriginTrail DKG Edge Node (must be on testnet; mainnet is refused).
DKG_API_URL=http://127.0.0.1:9200
# The node's auth token is read from $DKG_HOME/auth.token, or set it directly.
DKG_HOME=~/.dkg
# DKG_AUTH_TOKEN=

# Public https location of the exported pack, recorded in the sound brief so a teammate can fetch the audio.
# ASSET_BASE_URL=https://example.com/packs/my-game/v1/

# Refuse briefs that belong to any other project when continuing on this instance.
# EXPECTED_PROJECT_ID=
